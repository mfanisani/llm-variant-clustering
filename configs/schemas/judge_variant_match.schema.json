{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "judge_variant_match.schema.json",
  "title": "Judge: match held-out variants to business cluster names (P9)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "answers"],
  "properties": {
    "schema_version": {"const": "p9"},
    "batch_id": {"type": "string", "minLength": 1},
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_id", "chosen_name_code", "confidence"],
        "properties": {
          "slot_id": {"type": "string", "minLength": 1},
          "chosen_name_code": {"type": "string", "minLength": 1},
          "confidence": {"type": "integer", "minimum": 1, "maximum": 5}
        }
      }
    }
  }
}
