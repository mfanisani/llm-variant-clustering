{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "variant_signature_p2.schema.json",
  "title": "P2 Evidence-Grounded Variant Semantic Signature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "variant_id",
    "primary_object",
    "apparent_goal",
    "ordered_stages",
    "explicit_outcome",
    "exception_or_correction",
    "short_description",
    "ambiguities"
  ],
  "properties": {
    "schema_version": {"const": "p2"},
    "variant_id": {"type": "string", "minLength": 1},
    "primary_object": {"$ref": "#/$defs/claim"},
    "apparent_goal": {"$ref": "#/$defs/claim"},
    "ordered_stages": {
      "type": "array",
      "items": {"$ref": "#/$defs/stage"}
    },
    "explicit_outcome": {"$ref": "#/$defs/claim"},
    "exception_or_correction": {"$ref": "#/$defs/claim"},
    "short_description": {"$ref": "#/$defs/claim"},
    "ambiguities": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "inference_type",
        "evidence_activity_indices",
        "confidence"
      ],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "inference_type": {
          "type": "string",
          "enum": ["observed", "inferred", "observed_absence", "unknown"]
        },
        "evidence_activity_indices": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0},
          "uniqueItems": true
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "inference_type",
        "evidence_activity_indices",
        "confidence"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "inference_type": {
          "type": "string",
          "enum": ["observed", "inferred"]
        },
        "evidence_activity_indices": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0},
          "uniqueItems": true
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
