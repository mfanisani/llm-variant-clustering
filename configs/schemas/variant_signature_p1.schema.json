{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "variant_signature_p1.schema.json",
  "title": "P1 Minimal Variant Semantic Signature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "variant_id",
    "primary_object",
    "apparent_goal",
    "main_stages",
    "explicit_outcome",
    "exception_pattern",
    "short_description",
    "uncertainty"
  ],
  "properties": {
    "schema_version": {"const": "p1"},
    "variant_id": {"type": "string", "minLength": 1},
    "primary_object": {"type": "string", "minLength": 1},
    "apparent_goal": {"type": "string", "minLength": 1},
    "main_stages": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "explicit_outcome": {"type": "string", "minLength": 1},
    "exception_pattern": {"type": "string", "minLength": 1},
    "short_description": {"type": "string", "minLength": 1},
    "uncertainty": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    }
  }
}

