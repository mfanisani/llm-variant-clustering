# Copy to .env (never commit it) or set these variables in your shell.
# PowerShell:  $env:AZURE_OPENAI_ENDPOINT = "https://<resource>.openai.azure.com/"
# bash:        export AZURE_OPENAI_ENDPOINT="https://<resource>.openai.azure.com/"

# Azure OpenAI resource that hosts gpt-4.1 (2025-04-14) and, for the robustness
# studies, gpt-4.1-mini, gpt-5 and text-embedding-3-small. Authentication uses
# Microsoft Entra ID through the Azure CLI (run `az login`); no key is read.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/

# Optional second resource for deepseek-v4-pro and gpt-4o-2024-08-06 (cluster-naming
# judges, normalizer robustness). Falls back to AZURE_OPENAI_ENDPOINT when unset.
AZURE_OPENAI_ENDPOINT_SECONDARY=

# Only for the public OpenAI API prompt pilot (scripts/run_openai_prompt_pilot.py).
OPENAI_API_KEY=

# Run every command from the repository root with these settings.
PYTHONPATH=src;scripts            # use src:scripts on Linux and macOS
PYTHONHASHSEED=0                  # process discovery depends on set iteration order
OMP_NUM_THREADS=2
HF_HUB_OFFLINE=1                  # set only after the models are cached in models/huggingface
